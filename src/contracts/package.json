{
  "name": "@webshop-gamefi/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart contracts for Webshop GameFi — KUB Chain (Bitkub Chain). Interface scaffolding only — real implementations pending legal opinion on token classification.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
